GEMINI_API_KEY=your_key
OPENAI_API_KEY=

# ERP SQL Server (same as EducationalERP Web.config — READ ONLY user recommended)
DB_SERVER=your_server
DB_NAME=Db_PortalERPHubspotOnboarding
DB_USER=your_user
DB_PASSWORD=your_password

